# ==============================================================================
# Smart Library Telegram Bot - Environment Variables Configuration
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Webhook Configuration (Must be a publicly accessible HTTPS URL)
WEBHOOK_URL=https://smartlibrary.yourdomain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=replace_with_a_secure_random_token_e9402ab84

# PostgreSQL Database (Asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/booklibrary

# Redis Cache and Rate Limiting
REDIS_URL=redis://redis:6379/0

# Administrators (Comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Google Books API Key (Optional, works without key with standard rate limits)
GOOGLE_BOOKS_API_KEY=

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=production
DEBUG=false

# Bot System Limits
MAX_DOWNLOAD_SIZE_MB=50
RATE_LIMIT_CALLS=10
RATE_LIMIT_PERIOD=3
SEARCH_PAGE_SIZE=5
DEFAULT_LANGUAGE=ru
